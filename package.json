{
  "name": "parametrica",
  "private": true,
  "version": "0.2.50",
  "type": "module",
  "description": "A parametric geometry workbench: discover continuous monoline forms by exploring mathematical equations, harmonics and parameter domains.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx test/lab.smoke.mjs && tsx test/domains/run.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build && npm run check:bundle && npm run check:specs && npm run check:version && npm run typecheck && npm run arch:check",
    "check:bundle": "node scripts/check-preview-bundle.mjs",
    "generate:e2e-session": "node scripts/generate-e2e-session.mjs",
    "pretest:e2e": "npm run generate:e2e-session",
    "check:specs": "node scripts/check-spec-purposes.mjs",
    "bench:instances": "node scripts/bench-instances.mjs",
    "bench:manifold": "node scripts/bench-manifold.mjs",
    "check:version": "node scripts/check-version.mjs",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json src"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "d3-delaunay": "^6.0.4",
    "gifenc": "^1.0.3",
    "lil-gui": "^0.19.2",
    "manifold-3d": "^3.5.4",
    "p5": "^1.11.0",
    "polygon-clipping": "^0.15.7",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.180.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.8"
  }
}
