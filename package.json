{
  "name": "parametrica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A parametric geometry workbench: discover continuous monoline forms by exploring mathematical equations, harmonics and parameter domains.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/lab.smoke.mjs && node test/domains/run.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build && npm run check:specs",
    "generate:e2e-session": "node scripts/generate-e2e-session.mjs",
    "pretest:e2e": "npm run generate:e2e-session",
    "check:specs": "node scripts/check-spec-purposes.mjs",
    "bench:instances": "node scripts/bench-instances.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "d3-delaunay": "^6.0.4",
    "gifenc": "^1.0.3",
    "lil-gui": "^0.19.2",
    "p5": "^1.11.0",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "vite": "^5.4.8"
  }
}
