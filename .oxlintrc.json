{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-unused-vars": ["error", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "caughtErrors": "none"
    }],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-constant-condition": "off",
    "no-useless-escape": "off"
  }
}
